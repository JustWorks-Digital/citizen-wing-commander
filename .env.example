# Postgres connection for Drizzle (server-only)
# Local example:
#   createdb citizen_wing_commander
#   DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/citizen_wing_commander
# Apply schema upgrades (local or deploy):
#   npm run db:upgrade
# Refresh ship stats from UEX into Postgres (session ship dropdown):
#   npm run db:sync-ships
# Copy one production trip (checklist + Source images) into local DB / .data:
#   npm run session:copy-from-prod -- <sessionId|tripUrl>
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/citizen_wing_commander

# Optional public site origin for MCP trip handoff links (defaults to Railway prod).
# APP_ORIGIN=http://localhost:3000
# Override when copying sessions from a non-default host:
# PROD_BASE_URL=https://citizen-wing-commander-production.up.railway.app
